al_spawner","nome":"Altar do Nascimento","qtd":1},{"tipo":"item","item":"naturesaura:birth_spirit","nome":"Espírito do Nascimento","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"100 de XP"}],"deps":["4AD4FDF70B9BFCC9","1D39634260A47C9A"],"opcional":false,"icone":"naturesaura:animal_spawner"},{"id":"34ABEF75AE1E5A0F","titulo":"Cajado do Conhecimento Ancestral","subtitulo":"Localizador de Netherite","desc":["O Cajado do Conhecimento Ancestral usa Aura para destacar Detritos Ancestrais próximos."],"tarefas":[{"tipo":"item","item":"naturesaura:netherite_finder","nome":"Cajado do Conhecimento Ancestral","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"100 de XP"}],"deps":["1D39634260A47C9A","22ADCF96AE3E609B"],"opcional":true,"icone":"naturesaura:netherite_finder"},{"id":"2B4D4E741D855B5A","titulo":"Barra das Profundezas","subtitulo":"","desc":["Combinar 2 **Barra dos Céus**, 2 **Lingote de Ouro Corrompido** e 1 Fragmento de Netherita juntos em uma grade de fabricação fará **Barra das Profundezas**."],"tarefas":[{"tipo":"item","item":"naturesaura:depth_ingot","nome":"Lingote das Profundezas","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"250 de XP"}],"deps":["1D39634260A47C9A"],"opcional":false,"icone":"naturesaura:depth_ingot"}]}