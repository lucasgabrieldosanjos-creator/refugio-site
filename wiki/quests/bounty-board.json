rrotar Stray","qtd":1},{"tipo":"kill","nome":"Derrotar Bogged","qtd":1},{"tipo":"kill","nome":"Derrotar Afundado","qtd":1},{"tipo":"kill","nome":"Derrotar Musgoso","qtd":1}],"recompensas":[{"tipo":"item","item":"mysticalagriculture:inferium_bow","nome":"Arco de Inferium","qtd":1},{"tipo":"xp","nome":"100 de XP"}],"deps":["42822B1E8A53D051"],"opcional":false,"icone":null},{"id":"1F31EBF49079F9D3","titulo":"Creepers Reformulados","subtitulo":"","desc":["**Creeper Overhaul** nos dá muitas variantes diferentes de Creepers para diferentes Biomas.","Cada um tem drops diferentes e alguns são até amigáveis!","Apesar de todos terem medo de **gatos**..."],"tarefas":[{"tipo":"kill","nome":"Derrotar Creeper do Ermo","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper de Espeleotema","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper de Pinheiro","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper do Pântano","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper da Caverna","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper de Bétula","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper do Oceano","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper da Selva","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper do Deserto","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper de Carvalho Escuro","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper de Bambu","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper da Praia","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper da Savana","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper da Colina","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper Cogumelo","qtd":1},{"tipo":"kill","nome":"Derrotar Creeper de Neve","qtd":1}],"recompensas":[{"tipo":"item","item":"creeperoverhaul:cave_creeper_spawn_egg","nome":"Invocar Creeper da Caverna","qtd":1},{"tipo":"item","item":"minecraft:gunpowder","nome":"Gunpowder","qtd":64},{"tipo":"item","item":"biomeswevegone:mini_cactus","nome":"Mini Cacto","qtd":1},{"tipo":"xp","nome":"100 de XP"}],"deps":["77FC692AC94D2EEF"],"opcional":false,"icone":null},{"id":"570223A03231DF8C","titulo":"Enderman Reformulados","subtitulo":"","desc":["Overhauled Enderman é um Mod semelhante ao **Creeper Overhaul**! Só que com Enderman, claro!","Você encontrará todos esses Endermen em biomas diferentes e cada um é único à sua maneira! Alguns têm ataques diferentes, alguns dropam Pérolas diferentes, e todos eles parecem diferentes!"],"tarefas":[{"tipo":"kill","nome":"Derrotar Enderman de Campos de Cogumelos","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman do Pântano","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman de Ermo","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman das Ilhas do End","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman de Caverna","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman Nevado","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman de Pináculos de Gelo","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman de Savana","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman da Floresta Carmesim","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman de Colinas Ventosas","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman do Deserto do Nether","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman do Deserto","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman de Coral","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman de Carvalho Escuro","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman do Vale de Areia das Almas","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman de Campos Floridos","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman da Floresta Distorcida","qtd":1},{"tipo":"kill","nome":"Derrotar Enderman do End","qtd":1}],"recompensas":[{"tipo":"item","item":"endermanoverhaul:cave_enderman_spawn_egg","nome":"Ovo Gerador de Enderman de Caverna","qtd":1},{"tipo":"item","item":"minecraft:ender_pearl","nome":"Ender Pearl","qtd":16},{"tipo":"item","item":"endermanoverhaul:soul_pearl","nome":"Pérola das Almas","qtd":8},{"tipo":"xp","nome":"100 de XP"}],"deps":["17F3AC15ADCFB175"],"opcional":false,"icone":null},{"id":"41C0948CD9D50322","titulo":"Quadro de Recompensas","subtitulo":"Matando Todas as Coisas","desc":["Aqui você encontrará todas as recompensas que pode obter ao derrotar inimigos."],"tarefas":[{"tipo":"advancement","nome":"Conquista do jogo"}],"recompensas":[{"tipo":"xp","nome":"10 de XP"}],"deps":[],"opcional":false,"icone":null},{"id":"728BE1816DA23DC0","titulo":"Mate o Dragão do End","subtitulo":"","desc":["O Dragão Ender é o Chefe que guarda O Fim.","Quando você entra em um Portal do End, chegará à Ilha do End onde ele aparece.","Ele tem 200 Corações e pode atacar com Bolas de Fogo ou te atingindo.","Você terá que quebrar os Cristais do End nos pilares, pois eles o curam, para poder matá-lo!","Uma vez que você o mate, ele dropará: Essência Arcana, Shaderbags Épicos, Pele de Dragão, Escamas de Dragão de dois mods diferentes e um monte de experiência!","Então, o Portal se abrirá para que você possa retornar ao Mundo Superior, ou você pode encontrar um Portal do End para explorar as ilhas externas. Você também encontrará um Ovo de Dragão no Portal."],"tarefas":[{"tipo":"kill","nome":"Matar 1 Dragão Ender","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"500 de XP"}],"deps":[],"opcional":false,"icone":"ftbquests:custom_icon"},{"id":"09C82CDDA800D8C9","titulo":"Mate o Wither","subtitulo":"","desc":["O Wither é o segundo Chefe do Minecraft, sendo este mais eletivo.","Você terá que construir o Wither para invocá-lo. Usar 4 Areias das Almas em forma de T e colocar 3 Crânios de Esqueleto Wither no topo irá invocá-lo!","Ele tem 300 Corações e voará por aí atirando Crânios de Wither em Jogadores ou Mobs.","Quando chegar à metade da vida, ele ganhará um escudo contra Projéteis e precisará ser morto com uma Espada ou Machado.","Quando você o matar, ele dropará: Estrela do Nether, chance de uma Alma Wither e um monte de Itens Corail."],"tarefas":[{"tipo":"kill","nome":"Matar 1 Wither","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"500 de XP"}],"deps":[],"opcional":false,"icone":"ftbquests:custom_icon"},{"id":"0E20A9B79D1C6637","titulo":"Mate o Warden","subtitulo":"","desc":["O Warden é um chefe adicionado na 1.20.","Ele aparece quando 3 Sculk Shriekers que surgem naturalmente são ativados em sequência, ou quando qualquer Shrieker é ativado após a aparição do primeiro Warden.","Ele é o Mob mais poderoso adicionado pelo Minecraft, com 500 Corações e mais de 20 Corações de dano com seus ataques.","Seus ataques incluem te atingir e Explosões Sônicas para os mais distantes.","Sua única fraqueza é ser cego, mas como o Demolidor, isso apenas tornou seus outros sentidos muito mais fortes! Se você estiver perto, ele pode te cheirar e cuidado ao fazer barulho!","Se de alguma forma você matá-lo, ele dropará: Catalisadores de Sculk, Carapaça de Warden e Coração das Profundezas."],"tarefas":[{"tipo":"kill","nome":"Mate 1 Warden","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"500 de XP"}],"deps":[],"opcional":false,"icone":"ftbquests:custom_icon"},{"id":"13BB75A7E1973488","titulo":"Mate a Monstruosidade Lunar","subtitulo":"","desc":["A Monstruosidade Lunar é o primeiro Chefe adicionado em Eternal Starlight.","Este vive no meio do Jardim Amaldiçoado, boa sorte para encontrá-lo e lutar contra ele!"],"tarefas":[{"tipo":"kill","nome":"Derrotar Monstruosidade Lunar","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"500 de XP"}],"deps":[],"opcional":false,"icone":"ftbquests:custom_icon"},{"id":"6DCDD55786025911","titulo":"Mate o Golem da Starlight","subtitulo":"","desc":["O Golem da Starlight é o segundo Chefe no Eternal Starlight.","Ele está carregando na Forja do Golem esperando por um Jogador para lutar contra ele!"],"tarefas":[{"tipo":"kill","nome":"Derrotar Golem da Starlight","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"500 de XP"}],"deps":[],"opcional":false,"icone":"ftbquests:custom_icon"},{"id":"56DA46DC82F6665D","titulo":"Mate a Wilden Chimera","subtitulo":"","desc":["A Wilden Chimera é um Chefe adicionado pelo Ars Nouveau e é necessária para progredir no mod.","Ele precisa ser invocado através de um ritual e depois combatido!"],"tarefas":[{"tipo":"kill","nome":"Mate 1 Wilden Chimera","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"500 de XP"}],"deps":[],"opcional":false,"icone":null},{"id":"199932BF623A6785","titulo":"Mate o Guardião Esquecido","subtitulo":"","desc":["O Guardião Esquecido é o Chefe do Undergarden.","Ele descansa na Estrutura da Catacumba."],"tarefas":[{"tipo":"kill","nome":"Derrotar Guardião Esquecido","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"500 de XP"}],"deps":[],"opcional":false,"icone":"ftbquests:custom_icon"},{"id":"734411D931A8CDBF","titulo":"Matar um Devastador","subtitulo":"","desc":["O Devastador é um Miniboss que só aparece em Invasões mais difíceis.","Se você não sabe o que são Invasões ou não entende a maneira atualizada, tudo bem, é para isso que servem as Missões!","Ao matar Capitães Saqueadores (aqueles que seguram Estandartes), você pode obter Poções Sinistras; quando você as bebe, recebe o Efeito Mau Presságio. Então, você pode andar perto de uma Vila e iniciar uma Invasão.","As Invasões gerarão Saqueadores, Defensores, Evocadores, Bruxas e Devastadores para lutar!"],"tarefas":[{"tipo":"kill","nome":"Derrotar Ravager","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"250 de XP"}],"deps":[],"opcional":false,"icone":"ftbquests:custom_icon"},{"id":"08D1CC753F6B4283","titulo":"Mate um Guardião Ancião","subtitulo":"","desc":["O Guardião Ancião era considerado um terceiro Chefe para o Minecraft antes do Defensor, mas eu o considero um Minichefe.","Os Guardiões Anciões aparecem em Monumentos Oceânicos. Três deles aparecem lá e infligirão Fadiga de Mineração em qualquer um por perto.","Se você quer os tesouros do Monumento Oceânico, precisará encontrá-los e matá-los! (Dica: sempre encontrei 1 na Sala do topo, 1 no extremo esquerdo e 1 no extremo direito!)","Eles têm 80 Corações e atacam como Guardiões normais, Lasers e Espinhos!","Ao morrer, eles droparão: Esponjas, Prismarinho e o almoço deles..."],"tarefas":[{"tipo":"kill","nome":"Mate 1 Guardião Ancião","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"250 de XP"}],"deps":[],"opcional":false,"icone":"ftbquests:custom_icon"},{"id":"3813F5C1760C3A79","titulo":"Matar um Piglin Bárbaro","subtitulo":"","desc":["A presença de Piglin Bárbaro aqui pode causar controvérsia, mas eu os considero Minibosses.","Eles aparecem em Bastiões com Piglins normais, mas estes são Hostis, não Neutros. Pessoalmente, eu odeio isso, especialmente porque se você os atacar, todos os Piglins se tornarão Hostis a você.","Eles têm 50 Corações e um Machado de Ouro para te atingir. Normalmente, Machados de Ouro mal causam dano, mas quando eles o usam, é divino de alguma forma!","Eles não dropam nada e agem mais como um obstáculo para os Bastiões!"],"tarefas":[{"tipo":"kill","nome":"Derrotar Piglin Brute","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"250 de XP"}],"deps":[],"opcional":false,"icone":"ftbquests:custom_icon"},{"id":"2CA9394459C24012","titulo":"Mate um Rotbeast","subtitulo":"","desc":["Rotbeasts são Minichefes que aparecem por todo o Undergarden."],"tarefas":[{"tipo":"kill","nome":"Derrotar Podrão","qtd":1}],"recompensas":[{"tipo":"sorteio","nome":"Recompensa sorteada"},{"tipo":"xp","nome":"250 de XP"}],"deps":[],"opcional":false,"icone":"ftbquests:custom_icon"},{"id":"0F55D0B4D5094EDB","titulo":"Mate o Aldeão Comerciante e Suas Lhamas Irritantes","subtitulo":"\"Isso é Pessoal\" - AlfredGG","desc":["Enquanto fazia muitas das **linhas de missões** para o **ATM7**, o **Aldeão Comerciante** achou que seria engraçado me empurrar constantemente na tela de missões.","\"Acabe com eles. Todos eles.\"","- AlfredGG","\"Eu concordo com isso!\"","- Toshiba"],"tarefas":[{"tipo":"kill","nome":"Mate 1 Wandering Trader","qtd":1},{"tipo":"kill","nome":"Matar 2 Lhamas de Vendedor","qtd":2}],"recompensas":[{"tipo":"item","item":"minecraft:iron_sword","nome":"Iron Sword","qtd":1},{"tipo":"xp","nome":"100 de XP"}],"deps":[],"opcional":true,"icone":"ftbquests:custom_icon"}]}